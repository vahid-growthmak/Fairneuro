# Public Sanity connection details.
#
# These are committed deliberately. NEXT_PUBLIC_* values are inlined into the
# browser bundle at build time, so they are public whatever we do — and the
# dataset is world-readable. Committing them means any deployment connects to
# the CMS without per-environment dashboard configuration.
#
# Secrets do NOT belong here. The write token and webhook secret live in
# .env.local locally (gitignored) and in the host's environment settings.
# See .env.example.

NEXT_PUBLIC_SANITY_PROJECT_ID=th11nlwk
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
