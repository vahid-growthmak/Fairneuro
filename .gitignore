# dependencies
node_modules

# build output
.next
out
.turbo
*.tsbuildinfo

# deployment
.vercel

# local environment — no env file is tracked.
# .env.example is the exception: it documents what has to be set, and
# carries no values. Every real value belongs in the host's environment
# settings (Vercel) and in .env.local for local work.
.env
.env.*
!.env.example

# generated
next-env.d.ts

# tooling / editors
.DS_Store
Thumbs.db
*.pem
npm-debug.log*
yarn-error.log*
.eslintcache
coverage

# working files that should not ship
.design-notes
.image-cache
