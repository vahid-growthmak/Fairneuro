# ─── Sanity CMS ──────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values.
# The site builds and renders without these; CMS-backed sections fall back to
# their built-in content until a project ID is set.

# Public — safe to expose to the browser, but REQUIRED for the CMS to work.
# No .env file is committed any more, so these must be set in the host's
# environment (Vercel → Settings → Environment Variables) and in .env.local
# for local work. Without them the site builds but falls back to its
# built-in content and /studio reports that Sanity is not configured.
NEXT_PUBLIC_SANITY_PROJECT_ID=th11nlwk
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Server-only secrets — never prefix these with NEXT_PUBLIC_.
# Viewer token, for reading drafts in preview mode.
# Create at sanity.io/manage → API → Tokens → Add token → Viewer.
SANITY_API_READ_TOKEN=

# Write-scoped token, only needed to run scripts/seed-sanity.js.
# Create at sanity.io/manage → API → Tokens → Add token → Editor.
SANITY_API_WRITE_TOKEN=

# Shared secret for the publish webhook that revalidates the live site.
# Generate one with:  openssl rand -base64 32
# Use the same value in sanity.io/manage → API → Webhooks → Secret.
SANITY_REVALIDATE_SECRET=

# ─── Outbound mail (Zoho) ────────────────────────────────────────────────────
# Used by /api/assessor-application to email assessor applications to the
# recruitment inbox. Without SMTP_USER and SMTP_PASSWORD the endpoint returns
# 503 and the application is NOT delivered.
#
# Zoho with two-factor authentication needs an application-specific password,
# not the account password:
#   Zoho Mail → Settings → Security → App Passwords → Generate New Password
#
# Use smtp.zoho.eu for EU-hosted accounts, smtp.zoho.com for US, smtp.zoho.in
# for India. Port 465 is implicit TLS; 587 uses STARTTLS.
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=465
SMTP_USER=management@fairneurodiagnostics.com
SMTP_PASSWORD=

# Where applications are delivered, and the address they are sent from.
# Zoho will only send as a mailbox or alias that exists on the account, so the
# applicant's address goes in Reply-To rather than From.
APPLICATIONS_TO=management@fairneurodiagnostics.com
APPLICATIONS_FROM=management@fairneurodiagnostics.com
